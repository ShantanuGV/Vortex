# ==============================================================================
# VORTEX Environment Configuration Template
# ==============================================================================

# Server Network Settings
PORT=5000
NODE_ENV=production
CORS_ORIGIN=*

# Mediasoup SFU Infrastructure Settings
# Internal interface IP to bind WebRTC sockets
MEDIASOUP_LISTEN_IP=0.0.0.0
# Public IPv4 or DNS name for WAN NAT traversal (e.g. AWS Elastic IP or server WAN IP)
# MEDIASOUP_ANNOUNCED_IP=198.51.100.1
# RTC Port range for UDP/TCP media traversal
MEDIASOUP_MIN_PORT=20000
MEDIASOUP_MAX_PORT=29999

# Anti-Abuse & Rate Limiting (max WebSocket events per second per socket)
RATE_LIMIT_PER_SEC=50

# WebRTC STUN Servers (comma-separated URLs)
VITE_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Enterprise TURN Relay Servers (Optional, needed for restrictive corporate firewalls / symmetric NATs)
# VITE_TURN_SERVERS=turn:turn.yourdomain.com:3478?transport=udp,turn:turn.yourdomain.com:3478?transport=tcp
# VITE_TURN_USERNAME=vortex_user
# VITE_TURN_CREDENTIAL=super_secure_credential

# Frontend Signaling Server URL (leave empty in production to use relative window.location.origin)
# VITE_SIGNALING_URL=http://localhost:5000
