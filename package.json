{
  "name": "vortex-meet",
  "version": "1.0.0",
  "private": true,
  "description": "VORTEX Video Collaboration Platform",
  "scripts": {
    "build": "npm install --prefix server && npm install --prefix client && npm run --prefix client build",
    "start": "npm --prefix server start",
    "server": "npm --prefix server start",
    "client": "npm --prefix client run dev",
    "rea:audit": "npx rea-agents evaluate-reconstruction-coverage .rea/reconstruction-ledger.json",
    "rea:doctor": "npx rea-agents doctor"
  }
}

